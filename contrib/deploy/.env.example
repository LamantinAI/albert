# Albert container secrets. Copy to `deploy/.env` and fill in.
# ALBERT_CONFIG and KAERU_VAULT_PATH are already baked into the image — only secrets
# go here. No ALBERT_OPENAI_KEY is needed in subscription mode.

# Telegram bot token. REQUIRED to run as a background service (`up -d`) — without it
# Albert falls back to a console channel, which only makes sense for an interactive
# `docker compose run`. Get one from @BotFather. Also set the real owner_chat in
# config/connectors/telegram/telegram.toml before building (see README).
# OCTO_TELEGRAM_TOKEN=123456:ABC-DEF...

# Optional: Yandex calendar app-password (only if you enable the calendar connector).
# OCTO_YANDEX_APP_PASSWORD=...

# Optional: Jira Personal Access Token (only if the jira connector is configured — set
# the real base_url in config/connectors/jira/jira.toml too). Bearer PAT, not a password.
# JIRA_TOKEN=...

# Optional: IMAP/SMTP credentials (only if the mail connector is enabled — an
# app-password, not the account password).
# OCTO_MAIL_USER=...
# OCTO_MAIL_PASS=...

# Optional: log verbosity override.
# RUST_LOG=albert=debug,octo_core=info
