# Keep the Docker build context small: source + config only.
target/
.git/
# Local operator state and source overrides are not image inputs.
.agent/
.cargo/config.toml
state/
kaeru/
**/telegram_acl.json
*.log
.env
.DS_Store

# Frontend dependencies and local browser reports are not embedded inputs.
**/node_modules/
**/playwright-report/
**/test-results/
